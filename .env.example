# =======================================================
# KISAN SAHAYAK - ENVIRONMENT CONFIGURATION (Vercel & Local)
# =======================================================

# 1. Turso Cloud SQLite Database (Free tier at https://turso.tech)
# Set these on Vercel and in your local .env
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# 2. Google Gemini API Key for dynamic AI reasoning (Optional fallback exists)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Optional local server port
PORT=5000
