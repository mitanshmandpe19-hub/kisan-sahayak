# =======================================================
# FRONTEND CONFIGURATION (Set on Vercel)
# =======================================================
# The public URL of your deployed backend on Render
# Example: https://kisan-sahayak-backend.onrender.com
VITE_API_URL=https://your-backend-service.onrender.com

# =======================================================
# BACKEND CONFIGURATION (Set on Render)
# =======================================================
# Google Gemini API Key for dynamic scheme eligibility reasoning
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Port - Render automatically sets this in production
PORT=5000

# (Optional) Frontend URL for strict CORS protection
# Example: https://kisan-sahayak.vercel.app or *
CLIENT_URL=https://your-frontend-app.vercel.app
